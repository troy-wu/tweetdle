# Copy to .env.local. With the Supabase values left blank the app runs on
# built-in sample puzzles with an in-memory store (no accounts, no leaderboard persistence).

# Public site URL (used for share links and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First puzzle day, YYYY-MM-DD. Puzzle #1 is played on this date.
NEXT_PUBLIC_LAUNCH_DATE=2026-11-15

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Any long random string; salts answer hashes and device ids.
TWEETDLE_SECRET=

# Server only. Vercel sets this for cron requests.
CRON_SECRET=
